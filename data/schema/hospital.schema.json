{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hospital record",
  "type": "object",
  "required": ["id", "name_zh", "name_en", "directions", "type", "city", "province", "source_list", "source_url", "verified_on"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "name_zh": {"type": "string"},
    "name_en": {"type": "string"},
    "directions": {
      "type": "array", "minItems": 1,
      "items": {"enum": ["oncology", "cardio-cerebrovascular", "reproductive", "checkup-longevity", "tcm", "orthopedics", "aesthetics"]}
    },
    "type": {"enum": ["public", "private", "foreign"]},
    "grade": {"type": "string", "description": "e.g. 三级甲等 / Grade 3A"},
    "city": {"type": "string"},
    "province": {"type": "string"},
    "strengths": {"type": "array", "items": {"type": "string"}, "description": "优势科室或专长"},
    "ranking": {
      "type": "object",
      "properties": {
        "list": {"type": "string"},
        "year": {"type": "integer"},
        "specialty": {"type": "string"},
        "rank": {"type": "integer"}
      }
    },
    "international_dept": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "phone": {"type": "string"},
        "url": {"type": "string"}
      }
    },
    "website": {"type": "string"},
    "source_list": {"type": "string", "description": "公开名单名称与年份"},
    "source_url": {"type": "string"},
    "verified_on": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "notes": {"type": "string"}
  }
}
